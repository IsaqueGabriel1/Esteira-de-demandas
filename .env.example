# Copie este arquivo para .env e preencha os valores. NUNCA versione o .env.

# Ambiente: development | production
APP_CONFIG=development

# Chave secreta do Flask (gere com: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=troque-por-uma-chave-aleatoria

# Banco PostgreSQL (evite os caracteres @ : / # na senha, pois ela vai na URL de conexão)
POSTGRES_DB=esteira
POSTGRES_USER=esteira
POSTGRES_PASSWORD=troque-esta-senha

# Gerente administrador criado na primeira inicialização (comando "flask seed")
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@agencia.gov.br
ADMIN_SENHA=troque-esta-senha-admin

# Portas no computador/servidor
APP_PORT=8000
DB_PORT=5432
HTTP_PORT=80

# Produção: true somente se o acesso for via HTTPS
SESSION_COOKIE_SECURE=false
GUNICORN_WORKERS=3
